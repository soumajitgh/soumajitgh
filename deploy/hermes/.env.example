# ==========================================
# Hermes Agent Deployment - Environment Variables
# ==========================================

# Configurable Ports (Default: 8642 for Gateway, 9119 for Dashboard)
HERMES_PORT=8642
DASHBOARD_PORT=9119

# LLM Provider API Keys (Provide at least one)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Messaging Integrations (Optional)
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=

# Dashboard Auth (Required — dashboard binds 0.0.0.0 and refuses to start
# without an auth provider configured; see README for details)
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
HERMES_DASHBOARD_BASIC_AUTH_SECRET=
