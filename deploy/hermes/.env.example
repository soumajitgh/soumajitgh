# ==========================================
# Hermes Agent Deployment - Environment Variables
# ==========================================

# Configurable Ports (Default: 8642 for Gateway, 9119 for Dashboard)
HERMES_PORT=8642
DASHBOARD_PORT=9119

# Data Persistence Directory
HERMES_HOME=/opt/data

# LLM Provider API Keys (Provide at least one)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Messaging Integrations (Optional)
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=

# Internal Service Config
GATEWAY_HEALTH_URL=http://hermes:8642
